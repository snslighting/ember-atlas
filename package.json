{
  "name": "ember-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build": "node build.js",
    "data:refresh": "node fetch-firms.js",
    "history:fetch": "node fetch-history.js",
    "history:build": "node build-history.js",
    "history:append": "node -e \"import('./append-live-history.js').then(m=>m.appendLiveHistory())\"",
    "preview": "node preview-pages.js",
    "history:audit": "node analyze-history.js",
    "harmonization:validate": "node validate-harmonization.js",
    "harmonization:external": "node supplemental-fire-validation.js",
    "harmonization:e2e": "node check-end-to-end.js",
    "monitor:build-history": "node --max-old-space-size=4096 build-monitor-history.js",
    "monitor:validate": "node validate-monitor.js"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "maplibre-gl": "^6.11.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "linkedom": "^0.18.13",
    "sharp": "0.35.5"
  }
}
